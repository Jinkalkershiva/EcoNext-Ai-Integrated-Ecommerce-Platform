# ==============================================================================
# EcoNext Microservices Environment Configuration Template (.env.example)
# Copy this file to .env and configure values for your local environment.
# ==============================================================================

# Server Ports
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
PRODUCT_SERVICE_PORT=8082
CART_SERVICE_PORT=8083
ORDER_SERVICE_PORT=8084
PAYMENT_SERVICE_PORT=8087
NOTIFICATION_SERVICE_PORT=8089
ANALYTICS_SERVICE_PORT=8085

# MySQL Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
AUTH_DB_NAME=econext_auth_db
CART_DB_NAME=econext_cart_db
PAYMENT_DB_NAME=econext_payment_db
NOTIFICATION_DB_NAME=econext_notification_db

# Security & JWT
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=true

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id_placeholder
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_placeholder
RAZORPAY_CURRENCY=INR
