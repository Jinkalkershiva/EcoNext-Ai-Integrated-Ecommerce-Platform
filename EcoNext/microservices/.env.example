# EcoNext Microservices Infrastructure Configuration (.env)

# ============================================================================
# Gateway Configuration
# ============================================================================
GATEWAY_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Microservice Target URLs (Used by API Gateway)
AUTH_SERVICE_URL=http://localhost:8081
PRODUCT_SERVICE_URL=http://localhost:8082
CART_SERVICE_URL=http://localhost:8083
ORDER_SERVICE_URL=http://localhost:8084
ANALYTICS_SERVICE_URL=http://localhost:8085
PERSONALIZATION_SERVICE_URL=http://localhost:8086
AI_SERVICE_URL=http://localhost:8000
DJANGO_BACKEND_URL=http://localhost:8000

# ============================================================================
# MySQL Multi-Database Configuration (Local MySQL 8.0)
# ============================================================================
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Specific Microservice Database Connection Strings (MySQL)
AUTH_DB_URL=jdbc:mysql://localhost:3306/econext_auth_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
PRODUCT_DB_URL=jdbc:mysql://localhost:3306/econext_product_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
CART_DB_URL=jdbc:mysql://localhost:3306/econext_cart_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
ORDER_DB_URL=jdbc:mysql://localhost:3306/econext_order_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
ANALYTICS_DB_URL=jdbc:mysql://localhost:3306/econext_analytics_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================================================
# Kafka Configuration
# ============================================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_EXTERNAL_PORT=9092
KAFKA_UI_PORT=8088

# ============================================================================
# Security / JWT Configuration
# ============================================================================
JWT_SECRET_KEY=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
